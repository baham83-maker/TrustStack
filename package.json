{
  "name": "supplement-trust-intelligence",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"vite --host 0.0.0.0\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "start:api": "node server/index.js",
    "start:dashboard": "bash scripts/start-dashboard.sh",
    "start:watchdog": "node scripts/watchdog.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "import:ingredient": "node scripts/import-ingredient-assessment.js",
    "import:ingredient-evidence": "node scripts/import-ingredient-evidence.js",
    "import:ingredient-candidates": "node scripts/import-ingredient-candidates.js",
    "search:product-documents": "node scripts/search-product-documents.js",
    "import:product-variants": "node scripts/import-product-variants.js",
    "review:catalogue-sources": "node scripts/review-catalogue-sources.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cheerio": "^1.0.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.52.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
